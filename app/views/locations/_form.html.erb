<%= form_with model: location, class: "space-y-5" do |f| %>
  <% if location.errors.any? %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl">
      <ul class="space-y-1">
        <% location.errors.full_messages.each do |msg| %>
          <li class="text-sm text-red-700"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. Orange County" %>
  </div>

  <div>
    <%= f.label :vc_identifier, "VC Identifier (fallback)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :vc_identifier, class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. Orange,VA" %>
    <p class="mt-1 text-xs text-gray-500">Used only when coordinates below are not set.</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :latitude, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :latitude, step: "any", class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. 38.3726" %>
    </div>
    <div>
      <%= f.label :longitude, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :longitude, step: "any", class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. -78.2585" %>
    </div>
  </div>
  <p class="mt-1 text-xs text-gray-500">Coordinates improve weather accuracy by routing to nearby actual stations instead of model data.</p>
  <div>
    <% if location.new_record? %>
    <div class="mt-2 p-3 bg-amber-50 border border-amber-200 rounded-lg text-xs text-amber-800">
      <i class="fa-solid fa-triangle-exclamation mr-1"></i>
      After adding this location, you'll need to update your Visual Crossing query to include it before weather data will appear.
    </div>
    <% end %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit location.new_record? ? "Create Location" : "Update Location", class: "px-5 py-2 bg-[#166534] text-white text-sm font-semibold rounded-lg hover:bg-[#14532d] transition cursor-pointer" %>
    <%= link_to "Cancel", locations_path, class: "px-5 py-2 text-sm font-medium text-gray-600 hover:text-gray-800" %>
  </div>
<% end %>

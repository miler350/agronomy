<%= content_for :head do %>
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet">
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>
  <style>
    #field-map { position: absolute; inset: 0; }
    .mapboxgl-popup-content {
      font-family: 'Inter', sans-serif;
      padding: 0;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 30px -5px rgba(0,0,0,0.15);
      min-width: 200px;
    }
    .map-legend {
      position: absolute;
      bottom: 32px;
      left: 16px;
      background: white;
      border-radius: 12px;
      padding: 12px 16px;
      box-shadow: 0 4px 20px -2px rgba(0,0,0,0.12);
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      z-index: 10;
    }
  </style>
<% end %>

<div class="flex flex-col h-full">
  <!-- Header -->
  <header class="px-8 py-4 bg-white border-b border-gray-200 flex justify-between items-center flex-shrink-0 z-10">
    <div>
      <h1 class="text-xl font-bold text-[#1F2937]">Field Map</h1>
      <p class="text-sm text-[#6B7280] mt-0.5">All fields · <%= PlantingEvent.count %> with GDD data · click any field for details</p>
    </div>
    <div class="flex items-center gap-3">
      <select id="map-style-select" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-[#16a34a] bg-white cursor-pointer">
        <option value="mapbox://styles/mapbox/satellite-streets-v12">Satellite</option>
        <option value="mapbox://styles/mapbox/light-v11">Light</option>
        <option value="mapbox://styles/mapbox/outdoors-v12">Terrain</option>
      </select>
    </div>
  </header>

  <!-- Map -->
  <div class="flex-1 relative overflow-hidden">
    <div id="field-map"></div>

    <!-- Legend -->
    <div class="map-legend">
      <p class="font-semibold text-gray-700 mb-2 text-xs uppercase tracking-wider">Status</p>
      <div class="space-y-1.5">
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-sm" style="background:#16a34a"></span><span class="text-gray-600">Ahead</span></div>
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-sm" style="background:#eab308"></span><span class="text-gray-600">On Track</span></div>
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-sm" style="background:#dc2626"></span><span class="text-gray-600">Delayed</span></div>
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-sm bg-gray-300"></span><span class="text-gray-600">No data</span></div>
      </div>
    </div>
  </div>
</div>

<script>
  mapboxgl.accessToken = '<%= ENV["MAPBOX_TOKEN"] %>';

  const fieldData = <%= raw @field_data_json %>;

  const statusColor = {
    on_track: '#eab308',
    ahead:    '#16a34a',
    delayed:  '#dc2626',
    no_data:  '#9ca3af'
  };

  const map = new mapboxgl.Map({
    container: 'field-map',
    style: 'mapbox://styles/mapbox/satellite-streets-v12',
    center: [-78.29, 38.33],
    zoom: 11
  });

  map.addControl(new mapboxgl.NavigationControl(), 'top-right');
  map.addControl(new mapboxgl.ScaleControl(), 'bottom-right');

  let cachedGeojson = null;
  const popup = new mapboxgl.Popup({ closeButton: true, maxWidth: '260px' });
  let hoveredId = null;

  function addFieldLayers() {
    if (!cachedGeojson) return;

    map.addSource('fields', { type: 'geojson', data: cachedGeojson, generateId: true });

    map.addLayer({
      id: 'fields-fill', type: 'fill', source: 'fields',
      paint: {
        'fill-color': ['match', ['get', 'status'], 'on_track', '#eab308', 'ahead', '#16a34a', 'delayed', '#dc2626', '#9ca3af'],
        'fill-opacity': ['case', ['boolean', ['feature-state', 'hover'], false], 0.75, 0.45]
      }
    });

    map.addLayer({
      id: 'fields-outline', type: 'line', source: 'fields',
      paint: {
        'line-color': ['match', ['get', 'status'], 'on_track', '#ca8a04', 'ahead', '#15803d', 'delayed', '#b91c1c', '#6b7280'],
        'line-width': 1.5
      }
    });

    map.addLayer({
      id: 'fields-labels', type: 'symbol', source: 'fields',
      layout: {
        'text-field': ['get', 'field_id'],
        'text-size': 11,
        'text-font': ['DIN Offc Pro Medium', 'Arial Unicode MS Bold'],
        'text-anchor': 'center'
      },
      paint: { 'text-color': '#ffffff', 'text-halo-color': 'rgba(0,0,0,0.4)', 'text-halo-width': 1 }
    });

    map.on('mousemove', 'fields-fill', e => {
      map.getCanvas().style.cursor = 'pointer';
      if (hoveredId !== null) map.setFeatureState({ source: 'fields', id: hoveredId }, { hover: false });
      hoveredId = e.features[0].id;
      map.setFeatureState({ source: 'fields', id: hoveredId }, { hover: true });
    });
    map.on('mouseleave', 'fields-fill', () => {
      map.getCanvas().style.cursor = '';
      if (hoveredId !== null) map.setFeatureState({ source: 'fields', id: hoveredId }, { hover: false });
      hoveredId = null;
    });

    map.on('click', 'fields-fill', e => {
      const p = e.features[0].properties;
      const statusLabel = { on_track: 'On Track', ahead: 'Ahead', delayed: 'Delayed', no_data: 'No Data' }[p.status] || 'No Data';
      const sBg = { on_track: '#fef9c3', ahead: '#dcfce7', delayed: '#fee2e2', no_data: '#f3f4f6' }[p.status] || '#f3f4f6';
      const sFg = { on_track: '#854d0e', ahead: '#15803d', delayed: '#b91c1c', no_data: '#6b7280' }[p.status] || '#6b7280';

      const html = p.has_data ? `
        <div style="padding:14px 16px;border-bottom:1px solid #f3f4f6">
          <div style="display:flex;justify-content:space-between;align-items:start;gap:8px">
            <div>
              <p style="font-weight:700;font-size:15px;color:#1f2937;margin:0">${p.field_id}</p>
              <p style="font-size:12px;color:#6b7280;margin:2px 0 0">${p.farm} &middot; ${p.acreage} ac</p>
            </div>
            <span style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:99px;background:${sBg};color:${sFg};white-space:nowrap">${statusLabel}</span>
          </div>
        </div>
        <div style="padding:12px 16px;font-size:13px;color:#374151;display:grid;grid-template-columns:1fr 1fr;gap:8px">
          <div><p style="color:#9ca3af;font-size:11px;margin:0 0 2px;text-transform:uppercase;letter-spacing:.05em">GDD</p><p style="font-weight:600;margin:0">${p.gdd}</p></div>
          <div><p style="color:#9ca3af;font-size:11px;margin:0 0 2px;text-transform:uppercase;letter-spacing:.05em">Stage</p><p style="font-weight:600;margin:0">${p.stage}</p></div>
          <div><p style="color:#9ca3af;font-size:11px;margin:0 0 2px;text-transform:uppercase;letter-spacing:.05em">Next</p><p style="font-weight:600;margin:0">${p.next_stage}</p></div>
          <div><p style="color:#9ca3af;font-size:11px;margin:0 0 2px;text-transform:uppercase;letter-spacing:.05em">GDD to Next</p><p style="font-weight:600;margin:0">${p.gdd_to_next}</p></div>
          <div style="grid-column:span 2"><p style="color:#9ca3af;font-size:11px;margin:0 0 2px;text-transform:uppercase;letter-spacing:.05em">Hybrid</p><p style="font-weight:600;margin:0">${p.product}</p></div>
          <div style="grid-column:span 2"><p style="color:#9ca3af;font-size:11px;margin:0 0 2px;text-transform:uppercase;letter-spacing:.05em">Planted</p><p style="font-weight:600;margin:0">${p.planted_on}</p></div>
        </div>
      ` : `
        <div style="padding:14px 16px">
          <p style="font-weight:700;font-size:15px;color:#1f2937;margin:0 0 2px">${p.field_id}</p>
          <p style="font-size:12px;color:#6b7280;margin:0">${p.farm} &middot; ${p.acreage} ac</p>
          <p style="font-size:12px;color:#9ca3af;margin:10px 0 0">No planting data this season</p>
        </div>
      `;
      popup.setLngLat(e.lngLat).setHTML(html).addTo(map);
    });
  }

  map.on('load', () => {
    fetch('/fields.geojson')
      .then(r => r.json())
      .then(geojson => {
        geojson.features.forEach(f => {
          const d = fieldData[f.properties.field_id];
          if (d) { Object.assign(f.properties, d, { has_data: true }); }
          else   { f.properties.has_data = false; f.properties.status = 'no_data'; }
        });
        cachedGeojson = geojson;
        addFieldLayers();

        const bounds = new mapboxgl.LngLatBounds();
        geojson.features.forEach(f => {
          const geom = f.geometry;
          const rings = geom.type === 'MultiPolygon'
            ? geom.coordinates.flatMap(poly => poly)
            : geom.coordinates;
          rings[0].forEach(c => bounds.extend(c));
        });
        map.fitBounds(bounds, { padding: 40, duration: 1000 });
      });
  });

  // Re-add layers after style change (setStyle wipes all sources/layers)
  document.getElementById('map-style-select').addEventListener('change', function() {
    map.setStyle(this.value);
    map.once('style.load', addFieldLayers);
  });
</script>

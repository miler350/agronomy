<%= content_for :head do %>
  <script src="https://cdn.plot.ly/plotly-3.1.1.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Field search
      var searchInput = document.getElementById('field-search');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          var q = this.value.toLowerCase();
          document.querySelectorAll('.field-row').forEach(function(row) {
            var name = row.querySelector('.field-name').textContent.toLowerCase();
            row.style.display = name.includes(q) ? '' : 'none';
          });
        });
      }

      // Forecast chart
      var chartEl = document.getElementById('forecast-chart');
      if (chartEl && typeof Plotly !== 'undefined') {
        var chartDates = <%= raw (@chart_readings || []).map { |r| r.date.strftime("%a %-d") }.to_json %>;
        var chartGdd   = <%= raw begin
          cumulative = 0
          (@chart_readings || []).map { |r|
            tmax = [r.max_temperature.to_f, 86].min
            tmin = [r.min_temperature.to_f, 50].max
            cumulative += [(tmax + tmin) / 2.0 - 50, 0].max
            cumulative.round
          }
        end.to_json %>;
        var data = [{
          x: chartDates.length ? chartDates : ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
          y: chartGdd.length   ? chartGdd   : [12,18,22,28,35,42,48],
          type: 'scatter', mode: 'lines', fill: 'tozeroy',
          line: { shape: 'spline', smoothing: 1.3, color: '#ffffff', width: 2 },
          fillcolor: 'rgba(255,255,255,0.2)', hoverinfo: 'y'
        }];
        var layout = {
          margin: { t:10, r:0, b:20, l:0 },
          paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
          xaxis: { showgrid:false, showline:false, zeroline:false, tickfont: { color:'rgba(255,255,255,0.6)', size:10 } },
          yaxis: { showgrid:false, showline:false, zeroline:false, showticklabels:false },
          showlegend: false, hovermode: 'x unified'
        };
        Plotly.newPlot('forecast-chart', data, layout, { responsive:true, displayModeBar:false });
      }
    });
  </script>
<% end %>

<div class="flex flex-col h-full">
  <!-- Header -->
  <header class="w-full px-8 py-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 z-10 glass-panel border-b border-white/40 sticky top-0">
    <div>
      <h1 class="text-2xl font-bold text-brand-brown">Farm Field Overview</h1>
      <p class="text-sm text-brand-muted mt-1">Cumulative Growing Degree Days (GDD) &middot; Last synced: <%= @last_synced&.in_time_zone("Eastern Time (US & Canada)")&.strftime("%b %-d, %-I:%M %p ET") %></p>
    </div>
    <div class="flex items-center gap-4 w-full sm:w-auto">
      <div class="relative w-full sm:w-64">
        <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        <input type="text" id="field-search" placeholder="Search fields..." class="w-full pl-10 pr-4 py-2.5 rounded-full border border-gray-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-[#FFDA77] focus:border-transparent text-sm">
      </div>
      <button class="w-10 h-10 rounded-full bg-white border border-gray-200 shadow-sm flex items-center justify-center text-brand-dark hover:bg-gray-50 flex-shrink-0">
        <i class="fa-regular fa-bell"></i>
      </button>
      <button class="px-5 py-2.5 rounded-full bg-brand-brown text-white text-sm font-medium hover:bg-[#3A2D25] transition-colors shadow-md flex-shrink-0">
        Export Data
      </button>
    </div>
  </header>

  <div class="p-8 space-y-8 overflow-y-auto z-10 flex-1">

    <!-- Top Widgets -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Weather Widget -->
      <section class="col-span-1 lg:col-span-2 bg-white rounded-[24px] p-6 shadow-card border border-gray-100">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-lg font-semibold text-brand-dark"><%= @weather_location&.name || "Weather" %> Forecast</h2>
          <%= form_tag root_path, method: :get, class: "inline" do %>
            <%= select_tag :location_id,
                options_from_collection_for_select(@locations, :id, :name, @weather_location&.id),
                onchange: "this.form.submit()",
                class: "text-sm text-brand-muted border border-gray-200 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-[#FFDA77] bg-white cursor-pointer" %>
          <% end %>
        </div>
        <% r = @today_reading %>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="p-4 rounded-[16px] border border-gray-100 flex flex-col items-center justify-center gap-2 bg-gray-50/50">
            <div class="w-10 h-10 rounded-full bg-[#FFDA77]/20 flex items-center justify-center text-[#F59E0B]">
              <i class="fa-solid fa-sun text-xl"></i>
            </div>
            <span class="text-xs text-brand-muted font-medium uppercase tracking-wider">Avg Temp</span>
            <span class="text-xl font-bold text-brand-dark"><%= r ? "#{r.temperature.round}°F" : "—" %></span>
          </div>
          <div class="p-4 rounded-[16px] border border-gray-100 flex flex-col items-center justify-center gap-2">
            <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-500">
              <i class="fa-solid fa-droplet text-xl"></i>
            </div>
            <span class="text-xs text-brand-muted font-medium uppercase tracking-wider">Precipitation</span>
            <span class="text-xl font-bold text-brand-dark"><%= r ? "#{r.precip.round(2)}\"" : "—" %></span>
          </div>
          <div class="p-4 rounded-[16px] border border-gray-100 flex flex-col items-center justify-center gap-2">
            <div class="w-10 h-10 rounded-full bg-green-50 flex items-center justify-center text-green-500">
              <i class="fa-solid fa-wind text-xl"></i>
            </div>
            <span class="text-xs text-brand-muted font-medium uppercase tracking-wider">Wind</span>
            <span class="text-xl font-bold text-brand-dark"><%= r ? "#{r.wind_speed.round} mph" : "—" %></span>
          </div>
          <div class="p-4 rounded-[16px] border border-gray-100 flex flex-col items-center justify-center gap-2">
            <div class="w-10 h-10 rounded-full bg-[#FFF7ED] flex items-center justify-center text-[#EA580C]">
              <i class="fa-solid fa-fire text-xl"></i>
            </div>
            <span class="text-xs text-brand-muted font-medium uppercase tracking-wider">Daily GDD</span>
            <% today_gdd = r ? [[([r.max_temperature.to_f, 86].min + [r.min_temperature.to_f, 50].max) / 2.0 - 50, 0].max.round, 0].max : nil %>
            <span class="text-xl font-bold text-brand-dark"><%= today_gdd ? "+#{today_gdd}" : "—" %></span>
          </div>
        </div>
      </section>

      <!-- GDD Forecast -->
      <section class="col-span-1 bg-gradient-to-br from-[#166534] to-[#15803d] rounded-[24px] p-6 shadow-card relative overflow-hidden text-white">
        <div class="flex justify-between items-center mb-4 relative z-10">
          <h2 class="text-lg font-semibold">GDD Forecast</h2>
          <span class="text-xs bg-white/20 px-2 py-1 rounded-md font-medium">Next 14 Days</span>
        </div>
        <div class="relative z-10">
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-3xl font-bold">+<%= @forecast_gdd || "—" %></span>
            <span class="text-sm font-medium opacity-80">Expected GDD</span>
          </div>
          <p class="text-sm opacity-90 mb-4">
            <% if @forecast_gdd && @forecast_gdd > 0 %>
              <%= @weather_location&.name %> forecast for the next 14 days.
            <% else %>
              No forecast data available for this location.
            <% end %>
          </p>
        </div>
        <div id="forecast-chart" class="h-[120px] w-full relative z-10"></div>
      </section>
    </div>

    <!-- Active Fields Progress -->
    <section class="bg-white rounded-[24px] p-6 shadow-card border border-gray-100">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-lg font-semibold text-brand-dark">Active Fields Progress</h2>
        <div class="flex gap-2">
          <button class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm font-medium text-brand-muted hover:bg-gray-50">Filter</button>
          <button class="px-3 py-1.5 rounded-lg bg-[#F3F4F6] text-sm font-medium text-brand-dark">All Fields</button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[900px]" id="fields-table">
          <thead>
            <tr class="border-b border-gray-100 text-xs text-brand-muted uppercase tracking-wider">
              <th class="pb-3 font-medium pl-4">Field</th>
              <th class="pb-3 font-medium">Planted</th>
              <th class="pb-3 font-medium">Hybrid</th>
              <th class="pb-3 font-medium">Accum. GDD</th>
              <th class="pb-3 font-medium w-48">Stage Progress</th>
              <th class="pb-3 font-medium">Next Stage</th>
              <th class="pb-3 font-medium">GDD to Next</th>
              <th class="pb-3 font-medium">Predicted Date</th>
              <th class="pb-3 font-medium">Status</th>
              <th class="pb-3 font-medium pr-4 text-right"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @rows.each do |row| %>
              <% pe     = row[:planting_event] %>
              <% result = row[:result] %>
              <% stage_short = result.current_stage&.name&.gsub(/\(.*?\)/, '')&.strip %>
              <% next_short  = result.next_stage&.name&.gsub(/\(.*?\)/, '')&.strip %>
              <% pct = [[result.calibrated_gdd / (result.next_stage&.gdd_threshold&.to_f || 2650) * 100, 0].max, 100].min.round %>
              <tr class="hover:bg-gray-50/50 transition-colors field-row">
                <td class="py-2 pl-4">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-[8px] bg-gray-100 flex items-center justify-center text-gray-500 flex-shrink-0">
                      <i class="fa-solid fa-wheat-awn text-xs"></i>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-brand-dark field-name"><%= pe.field.name %></p>
                      <p class="text-xs text-brand-muted"><%= pe.field.location.name %></p>
                    </div>
                  </div>
                </td>
                <td class="py-2 text-xs text-brand-dark"><%= pe.planted_on.strftime("%b %-d") %></td>
                <td class="py-2 text-xs text-brand-muted"><%= pe.product %></td>
                <td class="py-2">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-brand-dark">
                    <%= number_with_delimiter(result.calibrated_gdd.round) %>
                  </span>
                </td>
                <td class="py-2 pr-4">
                  <div class="flex flex-col gap-1">
                    <div class="flex justify-between text-xs">
                      <span class="font-medium text-brand-dark"><%= stage_short || "—" %></span>
                      <span class="text-brand-muted"><%= result.gdd_to_next > 0 ? "#{result.gdd_to_next} to #{next_short}" : "" %></span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
                      <div class="progress-gradient h-1.5 rounded-full" style="width: <%= pct %>%"></div>
                    </div>
                  </div>
                </td>
                <td class="py-2 text-xs text-brand-dark"><%= next_short || "—" %></td>
                <td class="py-2 text-xs text-brand-muted"><%= result.gdd_to_next %></td>
                <td class="py-2 text-xs text-brand-dark"><%= result.predicted_next_date&.strftime("%b %-d") || "—" %></td>
                <td class="py-2">
                  <% status_styles = { on_track: "bg-green-50 text-green-700 border-green-200", ahead: "bg-blue-50 text-blue-700 border-blue-200", delayed: "bg-orange-50 text-orange-700 border-orange-200" } %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border <%= status_styles[result.status] %>">
                    <%= result.status.to_s.tr("_", " ").capitalize %>
                  </span>
                </td>
                <td class="py-2 pr-4 text-right">
                  <button class="px-2.5 py-1 rounded-lg text-xs font-medium bg-green-50 text-green-700 hover:bg-green-100 transition-colors whitespace-nowrap border border-green-200">
                    + Observation
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

  </div>
</div>

<%# ── Observation Drawer ────────────────────────────────────────────────── %>
<div id="obs-drawer" style="position:fixed;inset:0;z-index:50;display:flex;justify-content:flex-end;visibility:hidden;">
  <div id="obs-backdrop" onclick="closeObsDrawer()" style="position:absolute;inset:0;background:rgba(0,0,0,0.35);opacity:0;transition:opacity 0.25s ease;"></div>
  <div id="obs-panel" style="position:relative;width:420px;max-width:100%;background:white;height:100%;overflow-y:auto;transform:translateX(100%);transition:transform 0.25s ease;box-shadow:-4px 0 24px rgba(0,0,0,0.08);">
    <div style="padding:24px;border-bottom:1px solid #f3f4f6;display:flex;align-items:center;justify-content:space-between;">
      <div>
        <h2 style="font-size:15px;font-weight:700;color:#1F2937;margin:0">Log Observation</h2>
        <p id="obs-field-name" style="font-size:12px;color:#6b7280;margin:2px 0 0"></p>
      </div>
      <button onclick="closeObsDrawer()" style="color:#9ca3af;background:none;border:none;cursor:pointer;font-size:18px;">&#x2715;</button>
    </div>

    <form id="obs-form" method="post" style="padding:24px;" data-turbo="false">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

      <div style="margin-bottom:16px;">
        <label style="display:block;font-size:12px;font-weight:500;color:#4b5563;margin-bottom:6px;">Date Observed</label>
        <input type="date" name="field_observation[observed_on]" id="obs-date"
               style="width:100%;border:1px solid #e5e7eb;border-radius:12px;padding:8px 12px;font-size:14px;box-sizing:border-box;font-family:inherit;">
      </div>

      <div style="margin-bottom:16px;">
        <label style="display:block;font-size:12px;font-weight:500;color:#4b5563;margin-bottom:6px;">Growth Stage Observed</label>
        <select name="field_observation[growth_stage_id]" id="obs-stage"
                style="width:100%;border:1px solid #e5e7eb;border-radius:12px;padding:8px 12px;font-size:14px;box-sizing:border-box;font-family:inherit;background:white;">
          <option value="">— Select stage —</option>
          <% @growth_stages.each do |stage| %>
            <option value="<%= stage.id %>">
              <%= stage.name %> (<%= stage.gdd_threshold.to_f.round %> GDD threshold)
            </option>
          <% end %>
        </select>
      </div>

      <div style="margin-bottom:20px;">
        <label style="display:block;font-size:12px;font-weight:500;color:#4b5563;margin-bottom:6px;">Notes <span style="color:#9ca3af;font-weight:400;">(optional)</span></label>
        <textarea name="field_observation[notes]" rows="3" placeholder="Field conditions, pest pressure, etc."
                  style="width:100%;border:1px solid #e5e7eb;border-radius:12px;padding:8px 12px;font-size:14px;box-sizing:border-box;font-family:inherit;resize:none;"></textarea>
      </div>

      <p style="font-size:11px;color:#9ca3af;margin:-10px 0 16px;">GDD will be auto-calculated from planting date to the observed date using weather data.</p>

      <div style="display:flex;gap:10px;">
        <button type="submit"
                style="flex:1;padding:10px;background:#166534;color:white;font-size:14px;font-weight:600;border-radius:12px;border:none;cursor:pointer;font-family:inherit;">
          Save Observation
        </button>
        <button type="button" onclick="closeObsDrawer()"
                style="padding:10px 20px;border:1px solid #e5e7eb;color:#6b7280;font-size:14px;font-weight:500;border-radius:12px;background:white;cursor:pointer;font-family:inherit;">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openObsDrawer(fieldId, fieldName) {
    document.getElementById('obs-field-name').textContent = fieldName;
    document.getElementById('obs-form').action = '/fields/' + fieldId + '/field_observations';
    document.getElementById('obs-date').value = '<%= Date.current %>';
    document.getElementById('obs-stage').value = '';
    var drawer = document.getElementById('obs-drawer');
    drawer.style.visibility = 'visible';
    setTimeout(function() {
      document.getElementById('obs-backdrop').style.opacity = '1';
      document.getElementById('obs-panel').style.transform = 'translateX(0)';
    }, 10);
  }
  function closeObsDrawer() {
    document.getElementById('obs-backdrop').style.opacity = '0';
    document.getElementById('obs-panel').style.transform = 'translateX(100%)';
    setTimeout(function() {
      document.getElementById('obs-drawer').style.visibility = 'hidden';
    }, 260);
  }
</script>

<%= content_for :head do %>
  <script src="https://cdn.plot.ly/plotly-3.1.1.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var sortCol = null, sortDir = 'asc';
      var numericSortCols = ['gdd', 'gddToNext'];
      var allSortCols = ['fieldName','farm','planted','hybrid','gdd','stage','nextStage','gddToNext','predicted','status'];

      window.applyTable = function() {
        var rows  = Array.from(document.querySelectorAll('.field-row'));
        var tbody = rows[0] && rows[0].parentNode;
        if (!tbody) return;

        var search       = (document.getElementById('field-search')?.value || '').toLowerCase();
        var filterLoc    = document.getElementById('filter-location')?.value || '';
        var filterFarm   = document.getElementById('filter-farm')?.value     || '';
        var filterStatus = document.getElementById('filter-status')?.value   || '';
        var filterStage  = document.getElementById('filter-stage')?.value    || '';

        rows.forEach(function(row) {
          var name = (row.dataset.fieldName || '').toLowerCase();
          var show = (!search || name.includes(search)) &&
                     (!filterLoc    || row.dataset.location === filterLoc)   &&
                     (!filterFarm   || row.dataset.farm     === filterFarm)  &&
                     (!filterStatus || row.dataset.status   === filterStatus) &&
                     (!filterStage  || row.dataset.stage    === filterStage);
          row.style.display = show ? '' : 'none';
        });

        if (sortCol) {
          var visibleRows = rows.filter(function(r){ return r.style.display !== 'none'; });
          visibleRows.slice().sort(function(a, b) {
            var va = a.dataset[sortCol] || '', vb = b.dataset[sortCol] || '';
            if (numericSortCols.includes(sortCol)) {
              var na = parseFloat(va) || 0, nb = parseFloat(vb) || 0;
              return sortDir === 'asc' ? na - nb : nb - na;
            }
            return sortDir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
          }).forEach(function(r) { tbody.appendChild(r); });
        }
      };

      window.setSort = function(col) {
        sortDir = (sortCol === col && sortDir === 'asc') ? 'desc' : 'asc';
        sortCol = col;
        allSortCols.forEach(function(c) {
          var el = document.getElementById('sort-icon-' + c);
          if (!el) return;
          el.textContent = sortCol === c ? (sortDir === 'asc' ? '↑' : '↓') : '↕';
          el.style.color  = sortCol === c ? '#166534' : '';
        });
        applyTable();
      };

      // Populate filter dropdowns from row data
      var rows     = Array.from(document.querySelectorAll('.field-row'));
      var locs     = [...new Set(rows.map(function(r){ return r.dataset.location; }).filter(Boolean))].sort();
      var farms    = [...new Set(rows.map(function(r){ return r.dataset.farm;     }).filter(Boolean))].sort();
      var stages   = [...new Set(rows.map(function(r){ return r.dataset.stage;    }).filter(Boolean))].sort();
      var locSel   = document.getElementById('filter-location');
      var farmSel  = document.getElementById('filter-farm');
      var stageSel = document.getElementById('filter-stage');
      locs.forEach(function(l)   { var o = document.createElement('option'); o.value = l; o.textContent = l; locSel.appendChild(o);   });
      farms.forEach(function(f)  { var o = document.createElement('option'); o.value = f; o.textContent = f; farmSel.appendChild(o);  });
      stages.forEach(function(s) { var o = document.createElement('option'); o.value = s; o.textContent = s; stageSel.appendChild(o); });

      // Search input
      var searchInput = document.getElementById('field-search');
      if (searchInput) searchInput.addEventListener('input', applyTable);

      // Forecast chart
      var chartEl = document.getElementById('forecast-chart');
      if (chartEl && typeof Plotly !== 'undefined') {
        var chartDates = <%= raw (@chart_readings || []).map { |r| r.date.strftime("%a %-d") }.to_json %>;
        var chartGdd   = <%= raw begin
          cumulative = 0
          (@chart_readings || []).map { |r|
            tmax = [r.max_temperature.to_f, 86].min
            tmin = [r.min_temperature.to_f, 50].max
            cumulative += [(tmax + tmin) / 2.0 - 50, 0].max
            cumulative.round
          }
        end.to_json %>;
        var data = [{
          x: chartDates.length ? chartDates : ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
          y: chartGdd.length   ? chartGdd   : [12,18,22,28,35,42,48],
          type: 'scatter', mode: 'lines', fill: 'tozeroy',
          line: { shape: 'spline', smoothing: 1.3, color: '#ffffff', width: 2 },
          fillcolor: 'rgba(255,255,255,0.2)', hoverinfo: 'y'
        }];
        var layout = {
          margin: { t:10, r:0, b:20, l:0 },
          paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
          xaxis: { showgrid:false, showline:false, zeroline:false, tickfont: { color:'rgba(255,255,255,0.6)', size:10 } },
          yaxis: { showgrid:false, showline:false, zeroline:false, showticklabels:false },
          showlegend: false, hovermode: 'x unified'
        };
        Plotly.newPlot('forecast-chart', data, layout, { responsive:true, displayModeBar:false });
      }
    });
  </script>
<% end %>

<div class="flex flex-col h-full">
  <!-- Header -->
  <header class="w-full px-4 sm:px-8 py-4 sm:py-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 z-10 glass-panel border-b border-white/40 sticky top-0">
    <div>
      <h1 class="text-2xl font-bold text-brand-brown">Operation Overview</h1>
      <p class="text-sm text-brand-muted mt-1">Cumulative Growing Degree Days (GDD) &middot; Last synced: <%= @last_synced&.in_time_zone("Eastern Time (US & Canada)")&.strftime("%b %-d, %-I:%M %p ET") %></p>
    </div>
    <div class="flex items-center gap-4 w-full sm:w-auto">
      <%= link_to dashboard_export_path(format: :csv), class: "px-5 py-2.5 rounded-full bg-brand-brown text-white text-sm font-medium hover:bg-[#3A2D25] transition-colors shadow-md flex-shrink-0" do %>
        Export Data
      <% end %>
    </div>
  </header>

  <div class="p-4 sm:p-8 space-y-4 sm:space-y-8 overflow-y-auto z-10 flex-1">

    <!-- Top Widgets -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Weather Widget -->
      <section class="col-span-1 lg:col-span-2 bg-white rounded-[24px] p-6 shadow-card border border-gray-100">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-lg font-semibold text-brand-dark"><%= @weather_location&.name || "Weather" %> Forecast</h2>
          <%= form_tag root_path, method: :get, class: "inline flex items-center gap-2" do %>
            <%= select_tag :location_id,
                options_from_collection_for_select(@locations, :id, :name, @weather_location&.id),
                onchange: "this.form.submit()",
                class: "text-sm text-brand-muted border border-gray-200 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-[#FFDA77] bg-white cursor-pointer" %>
            <% if params[:forecast_days].present? %>
              <input type="hidden" name="forecast_days" value="<%= @forecast_days %>">
            <% end %>
          <% end %>
        </div>
        <% r = @today_reading %>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="p-4 rounded-[16px] border border-gray-100 flex flex-col items-center justify-center gap-2 bg-gray-50/50">
            <div class="w-10 h-10 rounded-full bg-[#FFDA77]/20 flex items-center justify-center text-[#F59E0B]">
              <i class="fa-solid fa-sun text-xl"></i>
            </div>
            <span class="text-xs text-brand-muted font-medium uppercase tracking-wider">Avg Temp</span>
            <span class="text-xl font-bold text-brand-dark"><%= r ? "#{r.temperature.round}°F" : "—" %></span>
          </div>
          <div class="p-4 rounded-[16px] border border-gray-100 flex flex-col items-center justify-center gap-2">
            <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-500">
              <i class="fa-solid fa-droplet text-xl"></i>
            </div>
            <span class="text-xs text-brand-muted font-medium uppercase tracking-wider">Precipitation</span>
            <span class="text-xl font-bold text-brand-dark"><%= r ? "#{r.precip.round(2)}\"" : "—" %></span>
          </div>
          <div class="p-4 rounded-[16px] border border-gray-100 flex flex-col items-center justify-center gap-2">
            <div class="w-10 h-10 rounded-full bg-green-50 flex items-center justify-center text-green-500">
              <i class="fa-solid fa-wind text-xl"></i>
            </div>
            <span class="text-xs text-brand-muted font-medium uppercase tracking-wider">Wind</span>
            <span class="text-xl font-bold text-brand-dark"><%= r ? "#{r.wind_speed.round} mph" : "—" %></span>
          </div>
          <div class="p-4 rounded-[16px] border border-gray-100 flex flex-col items-center justify-center gap-2">
            <div class="w-10 h-10 rounded-full bg-[#FFF7ED] flex items-center justify-center text-[#EA580C]">
              <i class="fa-solid fa-fire text-xl"></i>
            </div>
            <span class="text-xs text-brand-muted font-medium uppercase tracking-wider">Daily GDD</span>
            <% today_gdd = r ? [[([r.max_temperature.to_f, 86].min + [r.min_temperature.to_f, 50].max) / 2.0 - 50, 0].max.round, 0].max : nil %>
            <span class="text-xl font-bold text-brand-dark"><%= today_gdd ? "+#{today_gdd}" : "—" %></span>
          </div>
        </div>
      </section>

      <!-- GDD Forecast -->
      <section class="col-span-1 bg-gradient-to-br from-[#166534] to-[#15803d] rounded-[24px] p-6 shadow-card relative overflow-hidden text-white">
        <div class="flex justify-between items-center mb-4 relative z-10">
          <h2 class="text-lg font-semibold">GDD Forecast</h2>
          <%= form_tag root_path, method: :get, class: "inline" do %>
            <% if params[:location_id].present? %>
              <input type="hidden" name="location_id" value="<%= @weather_location&.id %>">
            <% end %>
            <select name="forecast_days" onchange="this.form.submit()"
                    class="text-xs bg-white/20 px-2 py-1 rounded-md font-medium text-white border-0 cursor-pointer focus:outline-none focus:ring-1 focus:ring-white/50">
              <option value="3"  style="background:#fff;color:#1f2937" <%= @forecast_days == 3  ? 'selected' : '' %>>Next 3 Days</option>
              <option value="7"  style="background:#fff;color:#1f2937" <%= @forecast_days == 7  ? 'selected' : '' %>>Next 7 Days</option>
              <option value="14" style="background:#fff;color:#1f2937" <%= @forecast_days == 14 ? 'selected' : '' %>>Next 14 Days</option>
            </select>
          <% end %>
        </div>
        <div class="relative z-10">
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-3xl font-bold">+<%= @forecast_gdd || "—" %></span>
            <span class="text-sm font-medium opacity-80">Expected GDD</span>
          </div>
          <p class="text-sm opacity-90 mb-4">
            <% if @forecast_gdd && @forecast_gdd > 0 %>
              <%= @weather_location&.name %> forecast, next <%= @forecast_days %> days.
            <% else %>
              No forecast data available for this location.
            <% end %>
          </p>
        </div>
        <div id="forecast-chart" class="h-[120px] w-full relative z-10"></div>
      </section>
    </div>

    <!-- Active Fields Progress -->
    <section class="bg-white rounded-[24px] p-6 shadow-card border border-gray-100">
      <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
        <h2 class="text-lg font-semibold text-brand-dark">Active Fields Progress</h2>
        <div class="flex items-center gap-2 flex-wrap">
          <input id="field-search" type="text" placeholder="Search field…"
                 class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-brand-muted bg-white focus:outline-none focus:ring-2 focus:ring-[#16a34a] w-36">
          <select id="filter-location" onchange="applyTable()" class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-medium text-brand-muted bg-white focus:outline-none focus:ring-2 focus:ring-[#16a34a]">
            <option value="">All Locations</option>
          </select>
          <select id="filter-farm" onchange="applyTable()" class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-medium text-brand-muted bg-white focus:outline-none focus:ring-2 focus:ring-[#16a34a]">
            <option value="">All Farms</option>
          </select>
          <select id="filter-status" onchange="applyTable()" class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-medium text-brand-muted bg-white focus:outline-none focus:ring-2 focus:ring-[#16a34a]">
            <option value="">All Statuses</option>
            <option value="on_track">On Track</option>
            <option value="ahead">Ahead</option>
            <option value="delayed">Delayed</option>
          </select>
          <select id="filter-stage" onchange="applyTable()" class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-medium text-brand-muted bg-white focus:outline-none focus:ring-2 focus:ring-[#16a34a]">
            <option value="">All Stages</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[1000px]" id="fields-table">
          <thead>
            <tr class="border-b border-gray-100 text-xs text-brand-muted uppercase tracking-wider">
              <th class="pb-3 font-medium pl-4 cursor-pointer select-none whitespace-nowrap" onclick="setSort('fieldName')">Field <span id="sort-icon-fieldName" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium cursor-pointer select-none whitespace-nowrap" onclick="setSort('farm')">Farm <span id="sort-icon-farm" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium cursor-pointer select-none whitespace-nowrap" onclick="setSort('planted')">Planted <span id="sort-icon-planted" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium cursor-pointer select-none whitespace-nowrap" onclick="setSort('hybrid')">Hybrid <span id="sort-icon-hybrid" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium cursor-pointer select-none whitespace-nowrap" onclick="setSort('gdd')">Accum. GDD <span id="sort-icon-gdd" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium cursor-pointer select-none whitespace-nowrap w-48" onclick="setSort('stage')">Stage <span id="sort-icon-stage" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium cursor-pointer select-none whitespace-nowrap" onclick="setSort('nextStage')">Next Stage <span id="sort-icon-nextStage" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium cursor-pointer select-none whitespace-nowrap" onclick="setSort('gddToNext')">GDD to Next <span id="sort-icon-gddToNext" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium cursor-pointer select-none whitespace-nowrap" onclick="setSort('predicted')">Predicted Date <span id="sort-icon-predicted" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium cursor-pointer select-none whitespace-nowrap" onclick="setSort('status')">Status <span id="sort-icon-status" class="text-gray-400 text-[10px]">↕</span></th>
              <th class="pb-3 font-medium pr-4 text-right"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @rows.each do |row| %>
              <% pe     = row[:planting_event] %>
              <% result = row[:result] %>
              <% stage_short = result.current_stage&.name&.gsub(/\(.*?\)/, '')&.strip %>
              <% next_short  = result.next_stage&.name&.gsub(/\(.*?\)/, '')&.strip %>
              <% pct = [[result.calibrated_gdd / (result.next_stage&.gdd_threshold&.to_f || 2650) * 100, 0].max, 100].min.round %>
              <tr class="hover:bg-gray-50/50 transition-colors field-row"
                  data-field-name="<%= pe.field.name.downcase %>"
                  data-location="<%= pe.field.location.name %>"
                  data-farm="<%= pe.field.farm.to_s %>"
                  data-status="<%= result.status %>"
                  data-stage="<%= result.current_stage&.name&.gsub(/\(.*?\)/, '')&.strip %>"
                  data-hybrid="<%= pe.product.to_s.downcase %>"
                  data-gdd="<%= result.calibrated_gdd.round %>"
                  data-next-stage="<%= next_short.to_s.downcase %>"
                  data-gdd-to-next="<%= result.gdd_to_next.to_f.round %>"
                  data-planted="<%= pe.planted_on %>"
                  data-predicted="<%= result.predicted_next_date || '' %>">
                <td class="py-2 pl-4">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-[8px] bg-gray-100 flex items-center justify-center text-gray-500 flex-shrink-0">
                      <i class="fa-solid fa-wheat-awn text-xs"></i>
                    </div>
                    <%= link_to pe.field.name, field_path(pe.field), class: "text-sm font-semibold text-brand-dark hover:text-[#166534] transition-colors field-name" %>
                  </div>
                </td>
                <td class="py-2 text-xs text-brand-muted"><%= pe.field.farm.presence || "—" %></td>
                <td class="py-2 text-xs text-brand-dark"><%= pe.planted_on.strftime("%b %-d") %></td>
                <td class="py-2 text-xs text-brand-muted"><%= pe.product %></td>
                <td class="py-2">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-brand-dark">
                    <%= number_with_delimiter(result.calibrated_gdd.round) %>
                  </span>
                </td>
                <td class="py-2 pr-4">
                  <div class="flex flex-col gap-1">
                    <div class="flex justify-between text-xs">
                      <span class="font-medium text-brand-dark"><%= stage_short || "—" %></span>
                      <span class="text-brand-muted"><%= result.gdd_to_next > 0 ? "#{result.gdd_to_next} to #{next_short}" : "" %></span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
                      <div class="progress-gradient h-1.5 rounded-full" style="width: <%= pct %>%"></div>
                    </div>
                  </div>
                </td>
                <td class="py-2 text-xs text-brand-dark"><%= next_short || "—" %></td>
                <td class="py-2 text-xs text-brand-muted"><%= result.gdd_to_next %></td>
                <td class="py-2 text-xs text-brand-dark"><%= result.predicted_next_date&.strftime("%b %-d") || "—" %></td>
                <td class="py-2">
                  <% status_styles = { on_track: "bg-yellow-50 text-yellow-700 border-yellow-200", ahead: "bg-green-50 text-green-700 border-green-200", delayed: "bg-red-50 text-red-700 border-red-200" } %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border <%= status_styles[result.status] %>">
                    <%= result.status.to_s.tr("_", " ").capitalize %>
                  </span>
                </td>
                <td class="py-2 pr-4 text-right">
                  <% if current_user.admin? %>
                  <button onclick="openObsDrawer(<%= pe.field.id %>, '<%= j pe.field.name %>')"
                          class="px-2.5 py-1 rounded-lg text-xs font-medium bg-green-50 text-green-700 hover:bg-green-100 transition-colors whitespace-nowrap border border-green-200">
                    + Observation
                  </button>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

  </div>
</div>

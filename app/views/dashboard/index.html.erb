<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f5f5f0;
    color: #1a1a1a;
  }

  header {
    background: #1a3a1a;
    color: white;
    padding: 16px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  header h1 { font-size: 20px; font-weight: 600; letter-spacing: 0.5px; }
  header .meta { font-size: 12px; color: #8fbc8f; }

  .container { padding: 24px 32px; }

  .summary { display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }

  .stat {
    background: white;
    border-radius: 8px;
    padding: 16px 24px;
    min-width: 140px;
    border: 1px solid #e0e0d8;
  }

  .stat .number { font-size: 28px; font-weight: 700; color: #1a3a1a; }
  .stat .label  { font-size: 12px; color: #666; margin-top: 2px; }

  table {
    width: 100%;
    background: white;
    border-radius: 8px;
    border: 1px solid #e0e0d8;
    border-collapse: collapse;
    font-size: 13px;
  }

  thead th {
    background: #1a3a1a;
    color: white;
    padding: 10px 14px;
    text-align: left;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.3px;
  }

  thead th:first-child { border-radius: 8px 0 0 0; }
  thead th:last-child  { border-radius: 0 8px 0 0; }

  tbody tr { border-bottom: 1px solid #f0f0e8; }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: #fafaf5; }
  tbody td { padding: 10px 14px; vertical-align: middle; }

  .field-name { font-weight: 600; }
  .location   { color: #666; font-size: 12px; }

  .gdd-bar-wrap { display: flex; align-items: center; gap: 8px; }
  .gdd-bar { flex: 1; height: 6px; background: #e8e8e0; border-radius: 3px; overflow: hidden; min-width: 80px; }
  .gdd-fill { height: 100%; border-radius: 3px; background: #4a9a4a; }
  .gdd-val { font-weight: 600; white-space: nowrap; }

  .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .badge-on-track { background: #e6f4e6; color: #2d6a2d; }
  .badge-ahead    { background: #e6f0ff; color: #2d4da0; }
  .badge-delayed  { background: #fff0e6; color: #a06020; }

  .no-next { color: #aaa; font-style: italic; }
</style>

<header>
  <h1>GDD Field Dashboard</h1>
  <div class="meta">
    Last synced: <%= @last_synced&.in_time_zone("Eastern Time (US & Canada)")&.strftime("%b %-d, %Y %-I:%M %p ET") || "—" %>
  </div>
</header>

<div class="container">

  <% total      = @rows.size %>
  <% avg_gdd    = (@rows.sum { |r| r[:result].calibrated_gdd } / [total, 1].max).round %>
  <% at_v3_plus = @rows.count { |r| r[:result].current_stage&.position.to_i >= 3 } %>
  <% on_track   = @rows.count { |r| r[:result].status == :on_track } %>

  <div class="summary">
    <div class="stat">
      <div class="number"><%= total %></div>
      <div class="label">Total Fields</div>
    </div>
    <div class="stat">
      <div class="number"><%= avg_gdd %></div>
      <div class="label">Avg GDD</div>
    </div>
    <div class="stat">
      <div class="number"><%= at_v3_plus %></div>
      <div class="label">Fields at V3+</div>
    </div>
    <div class="stat">
      <div class="number"><%= on_track %></div>
      <div class="label">On Track</div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Field</th>
        <th>Planted</th>
        <th>Accumulated GDD</th>
        <th>Current Stage</th>
        <th>Next Stage</th>
        <th>GDD to Next</th>
        <th>Predicted Date</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <% pe     = row[:planting_event] %>
        <% result = row[:result] %>
        <% pct    = [[result.calibrated_gdd / 2650.0 * 100, 0].max, 100].min.round %>
        <tr>
          <td>
            <div class="field-name"><%= pe.field.name %></div>
            <div class="location"><%= pe.field.location.name %></div>
          </td>
          <td><%= pe.planted_on.strftime("%b %-d") %></td>
          <td>
            <div class="gdd-bar-wrap">
              <div class="gdd-bar">
                <div class="gdd-fill" style="width: <%= pct %>%"></div>
              </div>
              <span class="gdd-val"><%= result.calibrated_gdd %></span>
            </div>
          </td>
          <td><%= result.current_stage&.name || "—" %></td>
          <td><%= result.next_stage&.name || '<span class="no-next">Complete</span>'.html_safe %></td>
          <td><%= result.next_stage ? result.gdd_to_next : "—" %></td>
          <td><%= result.predicted_next_date&.strftime("%b %-d") || "—" %></td>
          <td>
            <% badge = { on_track: "badge-on-track", ahead: "badge-ahead", delayed: "badge-delayed" }[result.status] %>
            <span class="badge <%= badge %>"><%= result.status.to_s.tr("_", " ").capitalize %></span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>

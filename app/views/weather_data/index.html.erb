<div class="flex flex-col h-full">
  <header class="px-8 py-5 bg-white border-b border-gray-200 flex justify-between items-center sticky top-0 z-10">
    <div>
      <h1 class="text-xl font-bold text-[#1F2937]">Weather Data</h1>
      <p class="text-sm text-[#6B7280] mt-0.5">Historical weather readings by location &mdash; last 60 days</p>
    </div>
    <% if @location %>
      <span class="text-xs text-[#6B7280] bg-gray-100 px-3 py-1 rounded-full font-medium">
        <i class="fa-solid fa-location-dot mr-1"></i>
        <%= @location.vc_identifier %>
      </span>
    <% end %>
  </header>

  <div class="p-8 space-y-6 overflow-y-auto flex-1">

    <!-- Location selector -->
    <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm p-5">
      <%= form_with url: weather_data_path, method: :get, local: true, class: "flex items-center gap-4" do |f| %>
        <label class="text-sm font-medium text-gray-700 whitespace-nowrap">Filter by Location:</label>
        <%= f.select :location_id,
              @locations.map { |l| [l.name, l.id] },
              { selected: @location&.id, include_blank: false },
              { class: "px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a]", onchange: "this.form.submit()" } %>
        <% unless @locations.any? %>
          <span class="text-sm text-gray-500">No locations configured.</span>
        <% end %>
      <% end %>
    </div>

    <% if @location && @readings %>
      <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm overflow-hidden">
        <table class="w-full text-left border-collapse min-w-[800px]">
          <thead>
            <tr class="border-b border-gray-100 text-xs text-[#6B7280] uppercase tracking-wider">
              <th class="pb-3 pt-4 px-6 font-medium">Date</th>
              <th class="pb-3 pt-4 px-4 font-medium">Max Temp</th>
              <th class="pb-3 pt-4 px-4 font-medium">Min Temp</th>
              <th class="pb-3 pt-4 px-4 font-medium">Avg Temp</th>
              <th class="pb-3 pt-4 px-4 font-medium">Precip</th>
              <th class="pb-3 pt-4 px-4 font-medium">Wind</th>
              <th class="pb-3 pt-4 px-4 font-medium">Humidity</th>
              <th class="pb-3 pt-4 px-4 font-medium">Conditions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @readings.each do |reading| %>
              <tr class="hover:bg-gray-50/50 transition-colors">
                <td class="py-2 px-6 text-xs font-medium text-[#1F2937]">
                  <%= reading.date.strftime("%b %-d, %Y") %>
                </td>
                <td class="py-2 px-4 text-xs text-[#1F2937]">
                  <% if reading.max_temperature %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-orange-50 text-orange-700">
                      <%= reading.max_temperature.to_f.round(1) %>&deg;F
                    </span>
                  <% else %>
                    <span class="text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="py-2 px-4 text-xs text-[#1F2937]">
                  <% if reading.min_temperature %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                      <%= reading.min_temperature.to_f.round(1) %>&deg;F
                    </span>
                  <% else %>
                    <span class="text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="py-2 px-4 text-xs text-[#6B7280]">
                  <%= reading.temperature ? "#{reading.temperature.to_f.round(1)}°F" : "—" %>
                </td>
                <td class="py-2 px-4 text-xs text-[#6B7280]">
                  <%= reading.precip ? "#{reading.precip.to_f.round(2)}\"" : "—" %>
                </td>
                <td class="py-2 px-4 text-xs text-[#6B7280]">
                  <%= reading.wind_speed ? "#{reading.wind_speed.to_f.round(1)} mph" : "—" %>
                </td>
                <td class="py-2 px-4 text-xs text-[#6B7280]">
                  <%= reading.humidity ? "#{reading.humidity.to_f.round(0)}%" : "—" %>
                </td>
                <td class="py-2 px-4 text-xs text-[#6B7280]">
                  <%= reading.conditions.presence || "—" %>
                </td>
              </tr>
            <% end %>
            <% if @readings.empty? %>
              <tr>
                <td colspan="8" class="py-12 px-6 text-center text-sm text-[#6B7280]">
                  <i class="fa-solid fa-cloud-sun text-2xl text-gray-300 mb-3 block"></i>
                  No weather data found for <%= @location.name %>.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% elsif @locations.empty? %>
      <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm p-12 text-center">
        <i class="fa-solid fa-cloud-sun text-3xl text-gray-300 mb-3 block"></i>
        <p class="text-sm text-gray-500">No locations configured yet. <%= link_to "Add a location", new_location_path, class: "text-[#166534] font-medium hover:underline" %> to start tracking weather data.</p>
      </div>
    <% end %>

  </div>
</div>

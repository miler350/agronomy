<%= content_for :head do %>
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet">
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>
  <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
  <style>
    #field-map { position: absolute; inset: 0; border-radius: 16px; overflow: hidden; }

    #obs-drawer {
      position: fixed; inset: 0; z-index: 50; display: flex; justify-content: flex-end;
      visibility: hidden;
    }
    #obs-drawer.open { visibility: visible; }
    #obs-backdrop {
      position: absolute; inset: 0; background: rgba(0,0,0,0.35);
      opacity: 0; transition: opacity 0.25s ease;
    }
    #obs-drawer.open #obs-backdrop { opacity: 1; }
    #obs-panel {
      position: relative; width: 420px; max-width: 100%; background: white;
      height: 100%; overflow-y: auto; transform: translateX(100%);
      transition: transform 0.25s ease; box-shadow: -4px 0 24px rgba(0,0,0,0.08);
    }
    #obs-drawer.open #obs-panel { transform: translateX(0); }
  </style>
<% end %>

<%# ─── Observation Drawer (create + edit) ─────────────────────────────── %>
<% if current_user.admin? %>
<div id="obs-drawer">
  <div id="obs-backdrop" onclick="closeDrawer()"></div>
  <div id="obs-panel">
    <div class="p-6 border-b border-gray-100 flex items-center justify-between">
      <div>
        <h2 id="drawer-title" class="text-base font-bold text-[#1F2937]">Log Observation</h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= @field.name %></p>
      </div>
      <button onclick="closeDrawer()" class="text-gray-400 hover:text-gray-600 transition">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="obs-form" method="post" class="p-6 space-y-5" data-turbo="false">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="_method" id="obs-method" value="">

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">Date Observed</label>
        <input type="date" name="field_observation[observed_on]" id="obs-date"
               value="<%= Date.current %>"
               class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a]">
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">Growth Stage Observed</label>
        <select name="field_observation[growth_stage_id]" id="stage-select"
                class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] bg-white">
          <option value="">— Select stage —</option>
          <% @growth_stages.each do |stage| %>
            <option value="<%= stage.id %>">
              <%= stage.name %>
              (<%= stage.days_threshold ? "Day #{stage.days_threshold}" : "#{stage.gdd_threshold.to_f.round} GDD" %>)
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">Notes <span class="text-gray-400 font-normal">(optional)</span></label>
        <textarea name="field_observation[notes]" id="obs-notes" rows="3" placeholder="Field conditions, pest pressure, etc."
                  class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] resize-none"></textarea>
      </div>

      <% if @tags.any? %>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">Tags <span class="text-gray-400 font-normal">(optional)</span></label>
        <div class="flex flex-wrap gap-2">
          <% @tags.each do |tag| %>
            <label class="obs-tag-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-sm cursor-pointer bg-white border-gray-200 text-gray-600 hover:border-gray-300">
              <input type="checkbox" name="field_observation[tag_ids][]" value="<%= tag.id %>"
                     class="sr-only obs-tag-checkbox">
              <%= tag.name %>
            </label>
          <% end %>
        </div>
        <input type="hidden" name="field_observation[tag_ids][]" value="">
      </div>
      <% end %>

      <p class="text-xs text-gray-400">GDD is auto-calculated from planting date to observation date using weather data.</p>

      <div class="flex gap-3 pt-2">
        <button type="submit"
                class="flex-1 py-2.5 bg-[#166534] text-white text-sm font-semibold rounded-xl hover:bg-[#14532d] transition">
          Save Observation
        </button>
        <button type="button" onclick="closeDrawer()"
                class="px-5 py-2.5 border border-gray-200 text-sm font-medium text-gray-600 rounded-xl hover:bg-gray-50 transition">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>
<% end %>

<%# ─── Main layout ────────────────────────────────────────────────────── %>
<div class="flex flex-col h-full overflow-y-auto">

  <header class="px-4 sm:px-8 py-4 sm:py-5 bg-white border-b border-gray-200 flex items-center gap-3 sticky top-0 z-10">
    <%= link_to fields_path, class: "text-gray-400 hover:text-gray-600 transition" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
    <div class="flex-1">
      <h1 class="text-xl font-bold text-[#1F2937]"><%= @field.name %></h1>
      <p class="text-sm text-[#6B7280] mt-0.5"><%= @field.location.name %><%= " · #{@field.farm}" if @field.farm.present? %></p>
    </div>
    <% if current_user.admin? %>
    <button onclick="openDrawer()"
            class="px-4 py-2 text-sm font-semibold bg-[#166534] text-white rounded-xl hover:bg-[#14532d] transition flex items-center gap-2">
      <i class="fa-solid fa-plus text-xs"></i> Log Observation
    </button>
    <%= link_to edit_field_path(@field), class: "px-4 py-2 text-sm font-medium bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition" do %>
      <i class="fa-solid fa-pencil mr-1.5"></i> Edit
    <% end %>
    <% end %>
  </header>

  <div class="p-4 sm:p-8 space-y-4 sm:space-y-6">

    <%# Map %>
    <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm overflow-hidden" style="height: 360px; position: relative;">
      <div id="field-map"></div>
    </div>

    <%# GDD stat cards %>
    <% if @gdd_result %>
    <% status_colors = { on_track: ["#fef9c3","#854d0e"], ahead: ["#dcfce7","#15803d"], delayed: ["#fee2e2","#b91c1c"] } %>
    <% bg, fg = status_colors[@gdd_result.status] || ["#f3f4f6","#6b7280"] %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-[16px] border border-gray-100 shadow-sm p-4">
        <% if @gdd_result.uses_calendar_days %>
          <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Days from Planting</p>
          <p class="text-2xl font-bold text-[#1F2937]"><%= @gdd_result.days_from_planting %></p>
        <% else %>
          <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Accum. GDD</p>
          <p class="text-2xl font-bold text-[#1F2937]"><%= number_with_delimiter(@gdd_result.cumulative_gdd.round) %></p>
        <% end %>
      </div>
      <div class="bg-white rounded-[16px] border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Current Stage</p>
        <p class="text-2xl font-bold text-[#1F2937]"><%= @gdd_result.current_stage&.name || "—" %></p>
      </div>
      <div class="bg-white rounded-[16px] border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Next Stage</p>
        <p class="text-2xl font-bold text-[#1F2937]"><%= @gdd_result.next_stage&.name || "—" %></p>
        <% if @gdd_result.gdd_to_next > 0 %>
          <p class="text-xs text-gray-400 mt-0.5">
            <%= @gdd_result.gdd_to_next.round %>
            <%= @gdd_result.uses_calendar_days ? "days away" : "GDD away" %>
          </p>
        <% end %>
      </div>
      <div class="bg-white rounded-[16px] border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Status</p>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-sm font-semibold" style="background:<%= bg %>;color:<%= fg %>">
          <%= @gdd_result.status.to_s.tr("_"," ").capitalize %>
        </span>
      </div>
    </div>

    <%# Planting details %>
    <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm p-6">
      <h2 class="text-sm font-semibold text-[#1F2937] mb-3">Planting Details</h2>
      <dl class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
        <div><dt class="text-gray-500">Hybrid</dt><dd class="font-medium text-[#1F2937] mt-0.5"><%= @current_planting_event.product %></dd></div>
        <div><dt class="text-gray-500">Planted</dt><dd class="font-medium text-[#1F2937] mt-0.5"><%= @current_planting_event.planted_on.strftime("%B %-d, %Y") %></dd></div>
        <div><dt class="text-gray-500">Predicted Next Stage</dt><dd class="font-medium text-[#1F2937] mt-0.5"><%= @gdd_result.predicted_next_date&.strftime("%b %-d") || "—" %></dd></div>
      </dl>
    </div>
    <% end %>

    <%# GDD Accumulation Chart %>
    <% if @gdd_chart_data.any? %>
    <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm p-6">
      <h2 class="text-sm font-semibold text-[#1F2937] mb-4">GDD Accumulation</h2>
      <div id="gdd-chart" style="height: 220px;"></div>
    </div>
    <% end %>

    <%# Observations %>
    <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-[#1F2937]">Field Observations</h2>
        <span class="text-xs text-gray-400"><%= @observations.size %> recorded</span>
      </div>

      <% if @observations.any? %>
        <table class="w-full text-left">
          <thead>
            <tr class="text-xs text-[#6B7280] uppercase tracking-wider border-b border-gray-100">
              <th class="px-6 py-3 font-medium">Date</th>
              <th class="px-4 py-3 font-medium">Stage Observed</th>
              <th class="px-4 py-3 font-medium">GDD at Observation</th>
              <th class="px-4 py-3 font-medium">Notes</th>
              <th class="px-4 py-3 font-medium">Tags</th>
              <th class="px-4 py-3 font-medium text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @observations.each do |obs| %>
              <tr class="hover:bg-gray-50/50 transition-colors">
                <td class="px-6 py-3 text-sm font-medium text-[#1F2937]">
                  <%= obs.observed_on.strftime("%b %-d, %Y") %>
                </td>
                <td class="px-4 py-3 text-sm text-[#1F2937]">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-800">
                    <%= obs.growth_stage.name %>
                  </span>
                </td>
                <td class="px-4 py-3 text-sm text-[#6B7280] font-mono">
                  <%= number_with_delimiter(obs.observed_gdd.to_f.round) %>
                </td>
                <td class="px-4 py-3 text-sm text-[#6B7280] max-w-xs whitespace-pre-wrap break-words">
                  <%= obs.notes.presence || "—" %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1">
                    <% obs.tags.each do |tag| %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-purple-50 text-purple-800"><%= tag.name %></span>
                    <% end %>
                  </div>
                </td>
                <td class="px-4 py-3 text-right flex items-center justify-end gap-3">
                  <% if current_user.admin? %>
                  <button onclick="openEditDrawer(<%= obs.id %>, '<%= j obs.observed_on.strftime('%Y-%m-%d') %>', '<%= obs.growth_stage_id %>', '<%= j obs.notes.to_s %>', <%= obs.tag_ids.to_json %>)"
                          class="text-xs text-blue-500 hover:text-blue-700 transition">
                    <i class="fa-solid fa-pencil"></i>
                  </button>
                  <%= form_with url: field_field_observation_path(@field, obs), method: :delete, data: { turbo: false }, style: "display:inline;" do %>
                    <button type="submit" onclick="return confirm('Delete this observation?')"
                            class="text-xs text-red-500 hover:text-red-700 transition">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="py-12 text-center">
          <i class="fa-solid fa-clipboard text-2xl text-gray-200 mb-3 block"></i>
          <p class="text-sm text-gray-400">No observations yet.</p>
          <% if current_user.admin? %>
          <button onclick="openDrawer()" class="mt-3 text-sm text-[#166534] font-medium hover:underline">
            Log the first one
          </button>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>

<script>
  // ── Observation Drawer ───────────────────────────────────────────────────
  function setObsTagCheckboxes(selectedIds) {
    document.querySelectorAll('.obs-tag-checkbox').forEach(function(cb) {
      cb.checked = (selectedIds || []).indexOf(parseInt(cb.value)) !== -1;
      var label = cb.closest('label');
      if (cb.checked) {
        label.classList.remove('bg-white', 'border-gray-200', 'text-gray-600', 'hover:border-gray-300');
        label.classList.add('bg-green-50', 'border-green-300', 'text-green-800');
      } else {
        label.classList.remove('bg-green-50', 'border-green-300', 'text-green-800');
        label.classList.add('bg-white', 'border-gray-200', 'text-gray-600', 'hover:border-gray-300');
      }
    });
  }

  document.querySelectorAll('.obs-tag-checkbox').forEach(function(cb) {
    cb.addEventListener('change', function() {
      var label = cb.closest('label');
      if (cb.checked) {
        label.classList.remove('bg-white', 'border-gray-200', 'text-gray-600', 'hover:border-gray-300');
        label.classList.add('bg-green-50', 'border-green-300', 'text-green-800');
      } else {
        label.classList.remove('bg-green-50', 'border-green-300', 'text-green-800');
        label.classList.add('bg-white', 'border-gray-200', 'text-gray-600', 'hover:border-gray-300');
      }
    });
  });

  function openDrawer() {
    document.getElementById('drawer-title').textContent = 'Log Observation';
    document.getElementById('obs-form').action = '<%= field_field_observations_path(@field) %>';
    document.getElementById('obs-method').value = '';
    document.getElementById('obs-date').value = '<%= Date.current %>';
    document.getElementById('stage-select').value = '';
    document.getElementById('obs-notes').value = '';
    setObsTagCheckboxes([]);
    document.getElementById('obs-drawer').classList.add('open');
  }

  function openEditDrawer(obsId, date, stageId, notes, tagIds) {
    document.getElementById('drawer-title').textContent = 'Edit Observation';
    document.getElementById('obs-form').action = '<%= field_field_observations_path(@field) %>/' + obsId;
    document.getElementById('obs-method').value = 'patch';
    document.getElementById('obs-date').value = date;
    document.getElementById('stage-select').value = stageId;
    document.getElementById('obs-notes').value = notes;
    setObsTagCheckboxes(tagIds || []);
    document.getElementById('obs-drawer').classList.add('open');
  }

  function closeDrawer() { document.getElementById('obs-drawer').classList.remove('open'); }

  // ── Mapbox ──────────────────────────────────────────────────────────────
  try {
    mapboxgl.accessToken = '<%= ENV["MAPBOX_TOKEN"] %>';
    const map = new mapboxgl.Map({
      container: 'field-map',
      style: 'mapbox://styles/mapbox/satellite-streets-v12',
      center: [<%= @field.longitude || -78.29 %>, <%= @field.latitude || 38.33 %>],
      zoom: 14
    });
    map.addControl(new mapboxgl.NavigationControl(), 'top-right');
    map.on('load', () => {
      fetch('/fields.geojson')
        .then(r => r.json())
        .then(geojson => {
          const feature = geojson.features.find(f => f.properties.field_id === '<%= j @field.name %>');
          if (!feature) return;
          const singleFeature = { type: 'FeatureCollection', features: [feature] };
          map.addSource('field', { type: 'geojson', data: singleFeature });
          map.addLayer({ id: 'field-fill', type: 'fill', source: 'field',
            paint: { 'fill-color': '#16a34a', 'fill-opacity': 0.35 } });
          map.addLayer({ id: 'field-outline', type: 'line', source: 'field',
            paint: { 'line-color': '#15803d', 'line-width': 2 } });

          const geom = feature.geometry;
          const bounds = new mapboxgl.LngLatBounds();
          if (geom.type === 'MultiPolygon') {
            geom.coordinates.forEach(poly => poly[0].forEach(c => bounds.extend(c)));
          } else {
            geom.coordinates[0].forEach(c => bounds.extend(c));
          }
          map.fitBounds(bounds, { padding: 40, duration: 800 });
        });
    });
  } catch(e) { console.error('Map error:', e); }

  // ── GDD Chart ───────────────────────────────────────────────────────────
  <% if @gdd_chart_data.any? %>
  try {
    const chartData = <%= raw @gdd_chart_data.to_json %>;
    Plotly.newPlot('gdd-chart', [{
      x: chartData.map(d => d.date),
      y: chartData.map(d => d.gdd),
      type: 'scatter',
      mode: 'lines',
      fill: 'tozeroy',
      line: { color: '#16a34a', width: 2 },
      fillcolor: 'rgba(22,163,74,0.08)',
      hovertemplate: '%{x}<br><b>%{y} GDD</b><extra></extra>'
    }], {
      margin: { t: 8, r: 16, b: 40, l: 52 },
      xaxis: { showgrid: false, tickfont: { size: 11, color: '#9ca3af' } },
      yaxis: { showgrid: true, gridcolor: '#f3f4f6', tickfont: { size: 11, color: '#9ca3af' }, title: { text: 'Cumul. GDD', font: { size: 11, color: '#9ca3af' } } },
      plot_bgcolor: 'white',
      paper_bgcolor: 'white',
      showlegend: false
    }, { responsive: true, displayModeBar: false });
  } catch(e) { console.error('Chart error:', e); }
  <% end %>
</script>

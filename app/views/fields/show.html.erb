<%= content_for :head do %>
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet">
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>
  <style>
    #field-map { position: absolute; inset: 0; border-radius: 16px; overflow: hidden; }
    .mapboxgl-popup-content { font-family: 'Inter', sans-serif; border-radius: 10px; }
  </style>
<% end %>

<div class="flex flex-col h-full overflow-y-auto">
  <!-- Header -->
  <header class="px-8 py-5 bg-white border-b border-gray-200 flex items-center gap-4 sticky top-0 z-10">
    <%= link_to fields_path, class: "text-gray-400 hover:text-gray-600 transition" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
    <div class="flex-1">
      <h1 class="text-xl font-bold text-[#1F2937]"><%= @field.name %></h1>
      <p class="text-sm text-[#6B7280] mt-0.5"><%= @field.location.name %></p>
    </div>
    <%= link_to edit_field_path(@field), class: "px-4 py-2 text-sm font-medium bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition" do %>
      <i class="fa-solid fa-pencil mr-1.5"></i> Edit
    <% end %>
  </header>

  <div class="p-8 space-y-6">

    <!-- Map -->
    <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm overflow-hidden" style="height: 420px; position: relative;">
      <div id="field-map"></div>
    </div>

    <!-- Stats row -->
    <% if @gdd_result %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% stage_short = @gdd_result.current_stage&.name %>
      <% next_short  = @gdd_result.next_stage&.name %>
      <% status_colors = { on_track: ["#dcfce7","#15803d"], ahead: ["#dbeafe","#1d4ed8"], delayed: ["#ffedd5","#c2410c"] } %>
      <% bg, fg = status_colors[@gdd_result.status] || ["#f3f4f6","#6b7280"] %>

      <div class="bg-white rounded-[16px] border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Accum. GDD</p>
        <p class="text-2xl font-bold text-[#1F2937]"><%= number_with_delimiter(@gdd_result.calibrated_gdd.round) %></p>
      </div>
      <div class="bg-white rounded-[16px] border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Current Stage</p>
        <p class="text-2xl font-bold text-[#1F2937]"><%= stage_short || "—" %></p>
      </div>
      <div class="bg-white rounded-[16px] border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Next Stage</p>
        <p class="text-2xl font-bold text-[#1F2937]"><%= next_short || "—" %></p>
        <% if @gdd_result.gdd_to_next > 0 %>
          <p class="text-xs text-gray-400 mt-0.5"><%= @gdd_result.gdd_to_next.round %> GDD away</p>
        <% end %>
      </div>
      <div class="bg-white rounded-[16px] border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Status</p>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-sm font-semibold" style="background:<%= bg %>;color:<%= fg %>">
          <%= @gdd_result.status.to_s.tr("_"," ").capitalize %>
        </span>
      </div>
    </div>

    <!-- Planting details -->
    <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm p-6">
      <h2 class="text-base font-semibold text-[#1F2937] mb-4">Current Planting</h2>
      <dl class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
        <div><dt class="text-gray-500">Hybrid</dt><dd class="font-medium text-[#1F2937] mt-0.5"><%= @current_planting_event.product %></dd></div>
        <div><dt class="text-gray-500">Planted</dt><dd class="font-medium text-[#1F2937] mt-0.5"><%= @current_planting_event.planted_on.strftime("%B %-d, %Y") %></dd></div>
        <div><dt class="text-gray-500">Predicted Next Stage</dt><dd class="font-medium text-[#1F2937] mt-0.5"><%= @gdd_result.predicted_next_date&.strftime("%b %-d") || "—" %></dd></div>
      </dl>
    </div>
    <% end %>

  </div>
</div>

<script>
  mapboxgl.accessToken = '<%= ENV["MAPBOX_TOKEN"] %>';
  const fieldName = '<%= @field.name %>';

  const map = new mapboxgl.Map({
    container: 'field-map',
    style: 'mapbox://styles/mapbox/satellite-streets-v12',
    center: [<%= @field.longitude || -78.29 %>, <%= @field.latitude || 38.33 %>],
    zoom: 14
  });

  map.addControl(new mapboxgl.NavigationControl(), 'top-right');

  map.on('load', () => {
    fetch('/fields.geojson')
      .then(r => r.json())
      .then(geojson => {
        const feature = geojson.features.find(f => f.properties.field_id === fieldName);
        if (!feature) return;

        const singleFeature = { type: 'FeatureCollection', features: [feature] };

        map.addSource('field', { type: 'geojson', data: singleFeature });

        map.addLayer({
          id: 'field-fill',
          type: 'fill',
          source: 'field',
          paint: { 'fill-color': '#16a34a', 'fill-opacity': 0.35 }
        });

        map.addLayer({
          id: 'field-outline',
          type: 'line',
          source: 'field',
          paint: { 'line-color': '#15803d', 'line-width': 2 }
        });

        // Fit to this field's bounds
        const bounds = new mapboxgl.LngLatBounds();
        feature.geometry.coordinates[0].forEach(c => bounds.extend(c));
        map.fitBounds(bounds, { padding: 40, duration: 800 });
      });
  });
</script>

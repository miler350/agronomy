<%= form_with model: field, class: "space-y-5" do |f| %>
  <% if field.errors.any? %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl">
      <ul class="space-y-1">
        <% field.errors.full_messages.each do |msg| %>
          <li class="text-sm text-red-700"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. North Field" %>
  </div>

  <div>
    <%= f.label :location_id, "Location", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :location_id, Location.order(:name).map { |l| [l.name, l.id] }, { include_blank: "Select location..." }, { class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a]" } %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :latitude, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :latitude, step: "any", class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. 38.2430" %>
    </div>
    <div>
      <%= f.label :longitude, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :longitude, step: "any", class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. -78.1612" %>
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Shapefile Boundary <span class="text-gray-400 font-normal">(optional)</span></label>
    <div class="flex items-center gap-3">
      <input type="file" id="shapefile-upload" accept=".zip"
             class="text-sm text-gray-600 file:mr-3 file:px-3 file:py-1.5 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-green-50 file:text-green-700 hover:file:bg-green-100 cursor-pointer">
      <span id="shapefile-status" class="text-xs"></span>
    </div>
    <%= f.hidden_field :geojson_polygon, id: "geojson-polygon" %>
    <% if field.geojson_polygon.present? %>
      <p class="mt-1 text-xs text-green-700"><i class="fa-solid fa-check mr-1"></i>Boundary already stored — upload a new file to replace it</p>
    <% else %>
      <p class="mt-1 text-xs text-gray-500">Upload a .zip shapefile to set the field boundary on the map</p>
    <% end %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-2">Tags</label>
    <% all_tags = Tag.order(:name) %>
    <% if all_tags.any? %>
      <div class="flex flex-wrap gap-2">
        <% all_tags.each do |tag| %>
          <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-sm cursor-pointer <%= field.tags.include?(tag) ? 'bg-green-50 border-green-300 text-green-800' : 'bg-white border-gray-200 text-gray-600 hover:border-gray-300' %>">
            <input type="checkbox" name="field[tag_ids][]" value="<%= tag.id %>"
                   <%= 'checked' if field.tags.include?(tag) %>
                   class="sr-only">
            <%= tag.name %>
          </label>
        <% end %>
      </div>
      <input type="hidden" name="field[tag_ids][]" value="">
    <% else %>
      <p class="text-sm text-gray-400">No tags yet. <a href="/tags" class="text-[#166534] hover:underline">Create some tags first.</a></p>
    <% end %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit field.new_record? ? "Create Field" : "Update Field", class: "px-5 py-2 bg-[#166534] text-white text-sm font-semibold rounded-lg hover:bg-[#14532d] transition cursor-pointer" %>
    <%= link_to "Cancel", fields_path, class: "px-5 py-2 text-sm font-medium text-gray-600 hover:text-gray-800" %>
  </div>
<% end %>

<script src="https://cdn.jsdelivr.net/npm/shpjs@4.0.2/dist/shp.js"></script>
<script>
  document.getElementById('shapefile-upload').addEventListener('change', function(e) {
    var file = e.target.files[0];
    if (!file) return;
    var status = document.getElementById('shapefile-status');
    status.textContent = 'Parsing…';
    status.style.color = '#6b7280';

    var reader = new FileReader();
    reader.onload = function(evt) {
      shp(evt.target.result).then(function(result) {
        var features = Array.isArray(result) ? result.flatMap(function(fc){ return fc.features; }) : result.features;
        if (!features || !features.length) {
          status.textContent = 'No features found in shapefile';
          status.style.color = '#dc2626';
          return;
        }
        var geometry;
        if (features.length === 1) {
          geometry = features[0].geometry;
        } else {
          var coords = features.flatMap(function(f) {
            return f.geometry.type === 'MultiPolygon' ? f.geometry.coordinates : [f.geometry.coordinates];
          });
          geometry = { type: 'MultiPolygon', coordinates: coords };
        }
        document.getElementById('geojson-polygon').value = JSON.stringify(geometry);
        status.textContent = features.length + ' feature' + (features.length > 1 ? 's' : '') + ' loaded ✓';
        status.style.color = '#166534';
      }).catch(function(err) {
        status.textContent = 'Error: ' + err.message;
        status.style.color = '#dc2626';
      });
    };
    reader.readAsArrayBuffer(file);
  });
</script>

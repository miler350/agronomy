<%= form_with model: event, class: "space-y-5" do |f| %>
  <% if event.errors.any? %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl">
      <ul class="space-y-1">
        <% event.errors.full_messages.each do |msg| %>
          <li class="text-sm text-red-700"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :crop_type, "Crop Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :crop_type, [["Corn", "corn"], ["Soybean", "soybean"]], {}, { class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a]" } %>
  </div>

  <div>
    <%= f.label :field_id, "Field", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :field_id, Field.includes(:location).order(:name).map { |field| ["#{field.name} (#{field.location.name})", field.id] }, { include_blank: "Select field..." }, { class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a]" } %>
  </div>

  <div>
    <%= f.label :product, "Product / Hybrid", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :product, class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. Pioneer P1197AM" %>
  </div>

  <div>
    <%= f.label :planted_on, "Planting Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :planted_on, class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit event.new_record? ? "Create Planting Event" : "Update Planting Event", class: "px-5 py-2 bg-[#166534] text-white text-sm font-semibold rounded-lg hover:bg-[#14532d] transition cursor-pointer" %>
    <%= link_to "Cancel", planting_events_path, class: "px-5 py-2 text-sm font-medium text-gray-600 hover:text-gray-800" %>
  </div>
<% end %>

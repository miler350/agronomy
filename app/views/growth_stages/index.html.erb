<div class="flex flex-col h-full">
  <header class="px-8 py-5 bg-white border-b border-gray-200 flex justify-between items-center sticky top-0 z-10">
    <div>
      <h1 class="text-xl font-bold text-[#1F2937]">Growth Stages</h1>
      <p class="text-sm text-[#6B7280] mt-0.5">Define GDD thresholds for each crop growth stage</p>
    </div>
    <% if current_user.admin? %>
    <%= link_to new_growth_stage_path, class: "flex items-center gap-2 px-4 py-2 bg-[#166534] text-white text-sm font-semibold rounded-xl hover:bg-[#14532d] transition" do %>
      <i class="fa-solid fa-plus text-xs"></i>
      New Stage
    <% end %>
    <% end %>
  </header>

  <div class="p-8 space-y-6 overflow-y-auto flex-1">
    <div class="bg-white rounded-[20px] border border-gray-100 shadow-sm overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-gray-100 text-xs text-[#6B7280] uppercase tracking-wider">
            <th class="pb-3 pt-4 px-6 font-medium">Position</th>
            <th class="pb-3 pt-4 px-4 font-medium">Crop</th>
            <th class="pb-3 pt-4 px-4 font-medium">Name</th>
            <th class="pb-3 pt-4 px-4 font-medium">GDD Threshold</th>
            <th class="pb-3 pt-4 px-4 font-medium">Description</th>
            <th class="pb-3 pt-4 px-4 font-medium text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @stages.each do |stage| %>
            <tr class="hover:bg-gray-50/50 transition-colors">
              <td class="py-2 px-6">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-green-50 text-green-700 text-xs font-bold">
                  <%= stage.position %>
                </span>
              </td>
              <td class="py-2 px-4">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= stage.crop_type == 'soybean' ? 'bg-blue-50 text-blue-700' : 'bg-yellow-50 text-yellow-700' %>">
                  <%= stage.crop_type.capitalize %>
                </span>
              </td>
              <td class="py-2 px-4">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-[8px] bg-green-50 flex items-center justify-center text-green-700 flex-shrink-0">
                    <i class="fa-solid fa-seedling text-xs"></i>
                  </div>
                  <span class="text-sm font-semibold text-[#1F2937]"><%= stage.name %></span>
                </div>
              </td>
              <td class="py-2 px-4">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-orange-50 text-orange-700 border border-orange-200">
                  <i class="fa-solid fa-fire mr-1 text-xs"></i>
                  <%= number_with_delimiter(stage.gdd_threshold) %> GDD
                </span>
              </td>
              <td class="py-2 px-4 text-xs text-[#6B7280] max-w-xs truncate"><%= stage.description.presence || "—" %></td>
              <% if current_user.admin? %>
              <td class="py-2 px-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to edit_growth_stage_path(stage), class: "px-3 py-1 rounded-lg text-xs font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 transition border border-gray-200" do %>
                    <i class="fa-solid fa-pencil mr-1"></i> Edit
                  <% end %>
                  <%= link_to stage, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete #{stage.name}?" }, class: "px-3 py-1 rounded-lg text-xs font-medium bg-red-50 text-red-600 hover:bg-red-100 transition border border-red-200" do %>
                    <i class="fa-solid fa-trash mr-1"></i> Delete
                  <% end %>
                </div>
              </td>
              <% end %>
            </tr>
          <% end %>
          <% if @stages.empty? %>
            <tr>
              <td colspan="6" class="py-12 px-6 text-center text-sm text-[#6B7280]">
                <i class="fa-solid fa-seedling text-2xl text-gray-300 mb-3 block"></i>
                No growth stages yet. <%= link_to "Add your first stage", new_growth_stage_path, class: "text-[#166534] font-medium hover:underline" %>.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= form_with model: stage, class: "space-y-5" do |f| %>
  <% if stage.errors.any? %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl">
      <ul class="space-y-1">
        <% stage.errors.full_messages.each do |msg| %>
          <li class="text-sm text-red-700"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. VT (Tasseling)" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :position, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :position, class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. 5" %>
      <p class="mt-1 text-xs text-gray-500">Order in which stages appear</p>
    </div>
    <div>
      <%= f.label :gdd_threshold, "GDD Threshold", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :gdd_threshold, step: "any", class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent", placeholder: "e.g. 1135" %>
      <p class="mt-1 text-xs text-gray-500">Cumulative GDD required to reach this stage</p>
    </div>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#16a34a] focus:border-transparent resize-none", placeholder: "Optional description of this growth stage..." %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit stage.new_record? ? "Create Stage" : "Update Stage", class: "px-5 py-2 bg-[#166534] text-white text-sm font-semibold rounded-lg hover:bg-[#14532d] transition cursor-pointer" %>
    <%= link_to "Cancel", growth_stages_path, class: "px-5 py-2 text-sm font-medium text-gray-600 hover:text-gray-800" %>
  </div>
<% end %>
